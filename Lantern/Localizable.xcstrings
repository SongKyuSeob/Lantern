    "%@ 설정 파일을 읽을 수 없어서 건드리지 않았어요. 파일 내용을 확인해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read the %@ settings file, so Lantern left it alone. Check the file's contents."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 설정 파일을 읽을 수 없어서 건드리지 않았어요. 파일 내용을 확인해 주세요."
          }
