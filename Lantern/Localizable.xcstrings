        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금까지 끝낸 일 · 지운 일 · 깨어 있기를 날짜별로 봐요"
          }
        }
      }
    },
    "지난번에 켜져 있던 뚜껑 닫아도 유지를 껐어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closed-Lid Mode was still on from last time, so Lantern turned it off."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난번에 켜져 있던 뚜껑 닫아도 유지를 껐어요."
          }
        }
