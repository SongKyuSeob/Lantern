    "지금까지 끝낸 일 · 지운 일 · 깨어 있기를 날짜별로 봐요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See completed and removed to-dos and Keep Awake sessions by date"
