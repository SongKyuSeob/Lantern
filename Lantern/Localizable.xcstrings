          }
        }
      }
    },
    "깨어 있기 꺼짐": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Awake off"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨어 있기 꺼짐"
          }
        }
      }
    },
    "깨어 있기 끄기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn Off Keep Awake"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨어 있기 끄기"
          }
        }
      }
    },
    "깨어 있기 상태와 할 일 개수만 한 줄로 보여 줘요. 메뉴바 아이콘 메뉴에서도 바꿀 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows just your Keep Awake status and to-do count. You can also change this from the menu bar icon."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨어 있기 상태와 할 일 개수만 한 줄로 보여 줘요. 메뉴바 아이콘 메뉴에서도 바꿀 수 있어요."
          }
        }
      }
    },
    "깨어 있기 시작": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Awake"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨어 있기 시작"
          }
        }
      }
    },
    "깨어 있기가 끝나면 %@을 설치하려고 기다리는 중이에요. 지금 설치하면 랜턴이 다시 켜지면서 깨어 있기가 끝나요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lantern will install %@ when your Keep Awake session ends. Installing now restarts Lantern and ends the session."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨어 있기가 끝나면 %@을 설치하려고 기다리는 중이에요. 지금 설치하면 랜턴이 다시 켜지면서 깨어 있기가 끝나요."
          }
        }
      }
    },
    "깨어 있는 동안 외장 모니터 없이 뚜껑을 닫아도 맥이 잠들지 않게 해요. 깨어 있기가 끝나거나 맥이 많이 뜨거워지면 저절로 꺼져요. 처음 한 번 관리자 비밀번호가 필요해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While Keep Awake is on, keeps your Mac awake with the lid closed, even without an external display. It turns off by itself when Keep Awake ends or your Mac gets too hot. You'll need your administrator password once."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨어 있는 동안 외장 모니터 없이 뚜껑을 닫아도 맥이 잠들지 않게 해요. 깨어 있기가 끝나거나 맥이 많이 뜨거워지면 저절로 꺼져요. 처음 한 번 관리자 비밀번호가 필요해요."
          }
        }
      }
    },
    "깨어 있는 동안만 켤 수 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available only while Keep Awake is on"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨어 있는 동안만 켤 수 있어요"
          }
        }
      }
    },
