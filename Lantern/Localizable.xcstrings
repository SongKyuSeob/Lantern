          }
        }
      }
    },
    "하루 한 번 새 버전이 있는지 확인해요. 설치는 직접 눌러야 해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks for a new version once a day. Nothing is installed until you click Install."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 한 번 새 버전이 있는지 확인해요. 설치는 직접 눌러야 해요."
          }
        }
      }
    },
