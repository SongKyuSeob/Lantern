<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 자동 업데이트(Sparkle). 나머지 Info.plist 항목은 빌드 설정(INFOPLIST_KEY_*)에서 만든다 -->
	<!-- 새 버전 정보는 GitHub 최신 릴리스에 함께 올린 appcast.xml에서 읽는다 -->
	<key>SUFeedURL</key>
	<string>https://github.com/SongKyuSeob/Lantern/releases/latest/download/appcast.xml</string>
	<!-- 업데이트 파일 서명 확인용 공개 키. 짝인 비밀 키는 배포하는 맥의 키체인에만 있다 -->
	<key>SUPublicEDKey</key>
	<string>Bf40wyxpUWiTE5fpvH7h8GQVz7ey4HSLf/5Hi0MZPbA=</string>
	<!-- 하루 한 번 조용히 확인한다. 처음 실행 때 "자동으로 확인할까요?"를 묻지 않는다 -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<!-- 몰래 설치하지 않는다: Sparkle 창의 "앞으로 자동으로 설치" 선택지를 숨긴다 -->
	<key>SUAllowsAutomaticUpdates</key>
	<false/>
	<!-- 내려받은 파일을 풀기 전에 서명부터 확인한다 -->
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
</dict>
</plist>
